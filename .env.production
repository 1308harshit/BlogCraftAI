# Production Environment Variables for BlogCraft AI
# Copy these to your Vercel deployment

# Groq API Key (Required)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe Configuration (Required)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Production App URL
NEXT_PUBLIC_APP_URL=https://blogcraft-ai.vercel.app

# Email Configuration for Outreach
EMAIL_USER=hello@blogcraft-ai.com
EMAIL_PASS=your_gmail_app_password

# Analytics & Tracking
INSTANTLY_API_KEY=your_instantly_api_key

# Company Information
COMPANY_NAME=BlogCraft AI
COMPANY_EMAIL=hello@blogcraft-ai.com
SUPPORT_EMAIL=support@blogcraft-ai.com