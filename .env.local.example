# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase Auth OAuth (optional; configure in Supabase Auth settings)
# NEXT_PUBLIC_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# AI Providers
OPENAI_API_KEY=sk_your_openai_key
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_key

# Razorpay (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_PLAN_PRO=plan_your_pro_plan_id
RAZORPAY_PLAN_BUSINESS=plan_your_business_plan_id

# Feature flags
DEMO_MODE=false

# WordPress integration (optional)
WORDPRESS_SITE_URL=https://your-site.com
WORDPRESS_USERNAME=your_wp_username
WORDPRESS_APP_PASSWORD=your_wp_app_password

# Optional FastAPI service (Phase 7)
AI_SERVICE_URL=http://localhost:8000

# ===== REVENUE ENGINE CONFIGURATION =====

# AI Brain & Learning System
AI_BRAIN_PERFORMANCE_THRESHOLD=0.2
AI_BRAIN_FEEDBACK_THRESHOLD=6
AI_BRAIN_PATTERN_CONFIDENCE=0.8
AI_BRAIN_COOLDOWN_HOURS=24
AI_BRAIN_MAX_ADAPTATIONS_PER_DAY=5
AI_LEARNING_MIN_SAMPLES=5
AI_LEARNING_CONFIDENCE=0.7
AI_LEARNING_IMPROVEMENT_THRESHOLD=0.1
AI_LEARNING_PATTERN_THRESHOLD=0.8

# Content Quality & Validation
CONTENT_QUALITY_THRESHOLD=0.7
MIN_READABILITY_SCORE=60
MIN_SEO_SCORE=50
MIN_ENGAGEMENT_POTENTIAL=65
MIN_WORD_COUNT=500
MAX_WORD_COUNT=5000
OPTIMAL_WORD_COUNT=2000

# Viral Prediction
VIRAL_TARGET_ACCURACY=0.85
VIRAL_MIN_CONFIDENCE=0.75
VIRAL_SCORE_THRESHOLD=0.7

# Monetization
AFFILIATE_RELEVANCE_THRESHOLD=0.90
MIN_CTA_PER_CONTENT=2
MAX_CTA_PER_CONTENT=4
REVENUE_PER_CLICK=0.50
CONVERSION_RATE_TARGET=0.02

# A/B Testing
AB_TEST_MIN_SAMPLE_SIZE=100
AB_TEST_MAX_DURATION_DAYS=14
AB_TEST_CONFIDENCE_LEVEL=0.95
AB_TEST_MIN_IMPROVEMENT=0.05

# Performance & SLA
MAX_RESPONSE_TIME_MS=2000
MIN_UPTIME_PERCENT=99.9
ERROR_RATE_THRESHOLD=0.01
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_MS=60000

# Rate Limiting
API_RATE_LIMIT=1000
API_RATE_WINDOW_SECONDS=60
CONTENT_GEN_RATE_LIMIT=100

# Database & Caching  
DB_CONNECTION_POOL_SIZE=20
DB_QUERY_TIMEOUT_MS=30000
REDIS_DEFAULT_TTL=3600
REDIS_SESSION_TTL=86400
REDIS_CACHE_TTL=300

# Security
SESSION_TIMEOUT_MS=3600000
TOKEN_EXPIRATION_MS=86400000
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000

# Monitoring
METRICS_COLLECTION_INTERVAL_MS=60000
LOG_RETENTION_COUNT=10000
HEALTH_CHECK_INTERVAL_MS=30000

# Content Generation
DEFAULT_WORD_COUNT=2000
BATCH_SIZE=30
TARGET_GENERATION_TIME_MS=600000
RETRY_ATTEMPTS=3

# Business Intelligence
FORECASTING_HORIZON_DAYS=90
MIN_DATA_POINTS_FOR_FORECAST=30
TREND_DETECTION_WINDOW_DAYS=7
GROWTH_THRESHOLD=0.15
