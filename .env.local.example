# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase Auth OAuth (optional; configure in Supabase Auth settings)
# NEXT_PUBLIC_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# AI Providers
OPENAI_API_KEY=sk_your_openai_key
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_key

# Razorpay (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_PLAN_PRO=plan_your_pro_plan_id
RAZORPAY_PLAN_BUSINESS=plan_your_business_plan_id

# Feature flags
DEMO_MODE=false

# WordPress integration (optional)
WORDPRESS_SITE_URL=https://your-site.com
WORDPRESS_USERNAME=your_wp_username
WORDPRESS_APP_PASSWORD=your_wp_app_password

# Optional FastAPI service (Phase 7)
AI_SERVICE_URL=http://localhost:8000
